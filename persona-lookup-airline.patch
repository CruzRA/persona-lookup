+        <span className="text-[var(--text-primary)]">{reservation.reservation_id}</span>
+      </nav>
+
+      <header className="p-6 bg-[var(--bg-secondary)] border border-[var(--border)] rounded-lg">
+        <div className="flex items-start justify-between">
